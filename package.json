{
  "name": "am-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AM Platform — 單一平台 + 多租戶(葉小蝸 AI 小幫手)。一支 OA → 一個 webhook → 依群組分流到各租戶 → 各租戶用自己的 Notion 頁。",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "check": "node --check server.js",
    "dryrun": "node --experimental-vm-modules tools/dryrun-core.mjs",
    "dryrun:personal-line": "node tools/dryrun-personal-line-routing.mjs",
    "dryrun:engineering": "node tools/dryrun-engineering-convergence.mjs",
    "dryrun:contract-review": "node tools/dryrun-engineering-contract-draft-review.mjs",
    "dryrun:task-card": "node tools/dryrun-task-card.mjs",
    "dryrun:groups": "node tools/dryrun-groups.mjs",
    "dryrun:finance-v3-direct": "node tools/dryrun-finance-v3-direct.mjs",
    "inventory:finance-v3-legacy": "node tools/inventory-finance-v3-legacy-jobs.mjs",
    "dryrun:processing-jobs": "node tools/dryrun-processing-jobs-store.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "mammoth": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
