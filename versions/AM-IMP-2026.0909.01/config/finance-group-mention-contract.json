{
  "contract": "hozo-rental-finance-group-mention-v1",
  "endpoint": "/control/hozo/rental/finance-group/push",
  "method": "POST",
  "access": "machine-only",
  "requiredBodyFields": ["text", "mentionName", "retryKey"],
  "forbiddenCallerFields": ["groupId", "userId"],
  "bindingSelector": "exact-normalized-canonical-title-or-群組名稱-across-all-pages",
  "identitySource": "selected-finance-group-binding.成員對照-flat-unique-key-map",
  "retryKey": "finance-notification:v1:sha256(normalized-payload-identity)",
  "providerRetryKey": "finance-provider:v1:sha256(caller-retry-key-plus-resolved-group-and-member)",
  "successGate": ["http-2xx", "ok=true", "mention.resolved=true", "mention.delivered=true"],
  "failurePolicy": "fail-closed-without-provider-push",
  "responseIdentityPolicy": "mention-name-and-booleans-only"
}
