{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "2026-08-28.engineering-contract-workflow.v1",
  "tenantKey": "engineering",
  "timezone": "Asia/Taipei",
  "authoritativeStore": "postgresql:engineering_contracts",
  "projectionStore": "notion:contracts",
  "fileStore": "google-drive:engineering-root/工程合約管理",
  "internalEntry": "/contracts?tenant=engineering",
  "publicEntryPattern": "/contract-sign#token={opaqueToken}",
  "oneExternalSigner": true,
  "requiredBundle": {
    "documentKinds": {
      "contract_body": { "minimum": 1, "maximum": 1 },
      "construction_drawing": { "minimum": 1 },
      "quotation": { "minimum": 1 },
      "acceptance_attachment": { "minimum": 0 },
      "other": { "minimum": 0 }
    },
    "paymentMilestonesMinimum": 1,
    "acceptanceCriteriaMinimum": 1,
    "everyFileRequires": ["driveFileId", "mimeType", "byteSize", "sha256"],
    "canonicalManifest": "RFC8785 JSON Canonicalization Scheme encoded as UTF-8; stored as a JSON array",
    "fileHash": "SHA-256 over exact raw file bytes, lowercase hexadecimal",
    "bundleHash": "SHA-256 over canonical manifest bytes, lowercase hexadecimal",
    "issuedPdfRequired": true,
    "issueFailurePolicy": "fail_closed"
  },
  "contractVersionStates": [
    "draft",
    "internal_review",
    "approved",
    "frozen",
    "issued",
    "superseded",
    "voided"
  ],
  "contractVersionTransitions": [
    { "from": "draft", "to": "internal_review" },
    { "from": "internal_review", "to": "draft" },
    { "from": "internal_review", "to": "approved" },
    { "from": "approved", "to": "draft" },
    { "from": "approved", "to": "frozen", "operation": "freezeVersion", "compareAndSet": { "expectedStatus": "approved" }, "gates": ["required_bundle", "canonical_manifest_array", "bundle_hash", "frozen_actor_and_time"] },
    { "from": "frozen", "to": "issued", "operation": "issueVersion", "gates": ["issued_pdf_drive_file_id", "issued_pdf_sha256", "issued_actor_and_time"], "allowedFieldChanges": ["status", "issued_pdf_drive_file_id", "issued_pdf_sha256", "issued_by", "issued_at", "updated_at"] },
    { "from": "frozen", "to": "superseded" },
    { "fromAny": ["draft", "internal_review", "approved", "frozen"], "to": "voided", "requiresReason": true }
  ],
  "token": {
    "randomBytesMinimum": 32,
    "transportEncoding": "base64url without padding",
    "storage": "HMAC-SHA-256(rawToken, tenant token pepper), lowercase hexadecimal",
    "rawTokenStored": false,
    "ttlSeconds": 604800,
    "maximumTtlSeconds": 604800,
    "clockAuthority": "PostgreSQL clock_timestamp()",
    "oneActiveSessionPerVersion": true,
    "resendExtendsExpiry": false,
    "reissueBehavior": "revoke previous active session and append evidence before creating a new session"
  },
  "signerVerification": {
    "allRequired": true,
    "steps": [
      "opaque token digest matches an active unexpired signing session",
      "LINE verifies the LIFF access token server-side",
      "verified LIFF profile userId exactly equals expected_signer_line_user_id",
      "expected_signer_line_user_id is a current member of line_group_id",
      "group_binding_notion_page_id is active and belongs to the contract project",
      "submitted bundleSha256 exactly equals the issued version bundle_sha256"
    ],
    "authorityFields": [
      "signing_sessions.expected_signer_line_user_id",
      "signing_sessions.group_binding_notion_page_id",
      "signing_sessions.line_group_id",
      "contract_versions.bundle_sha256"
    ],
    "neverAuthority": [
      "display name",
      "typed signer name",
      "browser tenant or project parameter",
      "browser operator field",
      "Notion status",
      "possession of a group-visible URL"
    ],
    "verificationUnavailablePolicy": "fail_closed"
  },
  "workflowStates": [
    "draft",
    "internal_review",
    "ready_to_issue",
    "issued",
    "sent",
    "opened",
    "signed",
    "in_progress",
    "completed",
    "closed",
    "declined",
    "expired",
    "revoked",
    "voided"
  ],
  "signingSessionStates": [
    "issued",
    "sent",
    "opened",
    "signed",
    "confirmed",
    "completed",
    "declined",
    "expired",
    "revoked"
  ],
  "transitions": [
    { "from": "draft", "to": "internal_review", "capability": "construction.contracts.manage" },
    { "from": "internal_review", "to": "draft", "capability": "construction.contracts.manage" },
    { "from": "internal_review", "to": "ready_to_issue", "capability": "construction.contracts.issue" },
    { "from": "ready_to_issue", "to": "draft", "capability": "construction.contracts.manage" },
    { "from": "ready_to_issue", "to": "issued", "capability": "construction.contracts.issue", "gates": ["required_bundle", "one_designated_signer", "active_same_project_group", "issued_pdf_hashed"] },
    { "from": "issued", "to": "sent", "trigger": "line_send_accepted" },
    { "from": "issued", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "sent", "to": "opened", "trigger": "designated_signer_identity_verified" },
    { "from": "sent", "to": "declined", "trigger": "designated_signer_declined" },
    { "from": "sent", "to": "expired", "trigger": "database_time_after_expiry" },
    { "from": "sent", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "opened", "to": "signed", "trigger": "signature_submission_committed", "gates": ["identity_reverified", "bundle_hash_match", "signed_event_appended", "submission_received_event_appended"] },
    { "from": "opened", "to": "declined", "trigger": "designated_signer_declined" },
    { "from": "opened", "to": "expired", "trigger": "database_time_after_expiry" },
    { "from": "opened", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "signed", "to": "in_progress", "capability": "construction.contracts.manage" },
    { "from": "in_progress", "to": "completed", "capability": "construction.contracts.manage" },
    { "from": "completed", "to": "closed", "capability": "construction.contracts.manage" },
    { "from": "signed", "to": "voided", "capability": "construction.contracts.void", "requiresReason": true },
    { "from": "in_progress", "to": "voided", "capability": "construction.contracts.void", "requiresReason": true },
    { "from": "completed", "to": "voided", "capability": "construction.contracts.void", "requiresReason": true },
    { "from": "closed", "to": "voided", "capability": "construction.contracts.void", "requiresReason": true }
  ],
  "signingSessionTransitions": [
    { "from": "issued", "to": "sent", "trigger": "line_send_accepted" },
    { "from": "issued", "to": "declined", "trigger": "designated_signer_declined" },
    { "from": "issued", "to": "expired", "trigger": "database_time_after_expiry" },
    { "from": "issued", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "sent", "to": "opened", "trigger": "designated_signer_identity_verified" },
    { "from": "sent", "to": "declined", "trigger": "designated_signer_declined" },
    { "from": "sent", "to": "expired", "trigger": "database_time_after_expiry" },
    { "from": "sent", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "opened", "to": "signed", "trigger": "signature_submission_committed", "gates": ["identity_reverified", "bundle_hash_match", "signed_event_appended", "submission_received_event_appended"] },
    { "from": "opened", "to": "declined", "trigger": "designated_signer_declined" },
    { "from": "opened", "to": "expired", "trigger": "database_time_after_expiry" },
    { "from": "opened", "to": "revoked", "capability": "construction.contracts.issue" },
    { "from": "signed", "to": "confirmed", "capability": "construction.contracts.manage", "gates": ["immutable_signature_stored", "signed_event_appended", "submission_received_event_appended"] },
    { "from": "confirmed", "to": "completed", "capability": "construction.contracts.manage", "gates": ["signed_pdf_hashed", "evidence_receipt_hashed"] }
  ],
  "eventTypes": [
    "issued",
    "sent",
    "delivery_ack",
    "first_opened",
    "signed",
    "submission_received",
    "confirmed",
    "completed",
    "revoked",
    "expired",
    "version_created",
    "version_reviewed",
    "version_issued",
    "line_send_requested",
    "line_send_accepted",
    "line_send_failed",
    "link_opened",
    "liff_verified",
    "group_membership_verified",
    "identity_verified",
    "identity_rejected",
    "signature_submitted",
    "signature_rejected",
    "signed_pdf_stored",
    "evidence_receipt_stored",
    "contract_signed",
    "signer_declined",
    "session_expired",
    "session_revoked",
    "contract_voided",
    "notion_projection_succeeded",
    "notion_projection_failed",
    "administrative_correction"
  ],
  "timestampSemantics": {
    "issuedAt": "contract version and signing session committed in PostgreSQL",
    "sentAt": "LINE Messaging API accepted the invitation request",
    "receivedAt": "designated signer first passed LIFF, exact-user, active-binding, same-project, and current-group-member checks",
    "signedAt": "PostgreSQL accepted the signature for the exact frozen bundle",
    "storedFormat": "timestamptz",
    "pdfDisplayTimezone": "Asia/Taipei",
    "receiptAlsoIncludesUtc": true
  },
  "finalPdfAnnotations": [
    "counterparty signature image",
    "verified signer name",
    "masked LINE user reference",
    "normalized signing IP address",
    "issuedAt",
    "sentAt",
    "receivedAt",
    "signedAt",
    "contract UUID",
    "version UUID and number",
    "bundle SHA-256",
    "signed PDF SHA-256",
    "event-chain head"
  ],
  "storage": {
    "postgresqlAuthority": ["workflow", "frozen snapshots", "token digests", "identity evidence", "hash-chained events", "artifact hashes"],
    "driveAuthority": ["source documents", "issued PDF", "signature image", "signed PDF", "evidence receipt"],
    "notionProjectionOnly": true,
    "notionMayCreateSignature": false,
    "notionMayOverridePostgres": false,
    "drivePublicSharingAllowed": false,
    "localFilesystemAuthorityAllowed": false
  },
  "outbox": {
    "required": true,
    "kinds": ["line_signing_invitation", "notion_contract_projection", "drive_artifact_integrity_check"],
    "idempotencyRequired": true,
    "notionFailureAffectsSigningAuthority": false,
    "lineAcceptanceRequiredForSentState": true
  },
  "legacyProjection": {
    "signedStateWrites": { "狀態": "已簽約", "簽署狀態": "已簽署" },
    "voidedStateWrites": { "狀態": "作廢", "簽署狀態": "已作廢" },
    "unsignedLegacyMarker": "舊資料／無電子簽署證據",
    "manualNotionSignedStatusIsEvidence": false,
    "budgetCommitStartsOnlyAfter": "contract_signed"
  }
}
