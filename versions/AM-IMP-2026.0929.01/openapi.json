{
  "openapi": "3.0.3",
  "info": {
    "title": "LINE Group Input / Output API",
    "version": "1.1.0",
    "description": "Server-side scoped API. Deployment base URL is configured by the operator; no production endpoint is asserted by this specification."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/line/groups": {
      "get": {
        "operationId": "listGroups",
        "description": "Requires groups:read. Returns only the client allowlist entries with a currently valid tenant binding.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tenantKey",
                    "groups"
                  ],
                  "properties": {
                    "tenantKey": {
                      "type": "string"
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Group"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/line/events": {
      "get": {
        "operationId": "readEvents",
        "description": "Requires events:read. Preserve nextCursor only after processing the whole page. Cursor values are strings. Ordered by durable ingestion, not LINE event timestamp. Unavailable configured groups fail the request instead of advancing past missing input.",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,19}$",
              "default": "0"
            },
            "description": "Exclusive bigint cursor, maximum 9223372036854775807."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "nextCursor",
                    "hasMore"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "nextCursor": {
                      "type": "string"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/line/messages": {
      "post": {
        "operationId": "sendText",
        "description": "Requires messages:write and active tenant group binding. Accepted means LINE accepted the request, not delivery, reading or business approval. Retry uncertain outcomes using the same key and payload within 23 hours.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "description": "Stable per report/group/part, scoped to tenant and client. Reuse with changed content returns 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "groupId",
                  "text"
                ],
                "properties": {
                  "groupId": {
                    "type": "string",
                    "pattern": "^C[0-9a-fA-F]{32}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4900,
                    "description": "Nonblank text. Runtime uses a conservative 4900 UTF-16 code unit limit; long reports must be explicitly split."
                  },
                  "notifyUserId": {
                    "type": "string",
                    "nullable": true,
                    "pattern": "^U[0-9a-fA-F]{32}$",
                    "description": "Optional per-request @recipient verified as a member of the authorized group. Omit for configured default; null disables @. Recipient is part of idempotency identity."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "400": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See README error table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated per-client API key. Not the LINE channel access token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "groupId",
          "writable"
        ],
        "properties": {
          "groupId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "bindingId": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "nullable": true
          },
          "writable": {
            "type": "boolean"
          },
          "inputUserIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "notifyUserId": {
            "type": "string",
            "nullable": true,
            "description": "Configured default recipient; POST notifyUserId may override it."
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "cursor",
          "receivedAt",
          "tenantKey",
          "groupId",
          "event"
        ],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tenantKey": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "bindingId": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "nullable": true
          },
          "event": {
            "type": "object",
            "additionalProperties": true,
            "description": "LINE webhook event without replyToken/quoteToken. Includes original type, timestamp, webhookEventId, source and message/postback/unsend metadata. On unsend, original message content is replaced with {id,unsent:true}. Treat content as untrusted input, not authorization."
          }
        }
      },
      "SendResult": {
        "type": "object",
        "required": [
          "status",
          "groupId",
          "idempotencyKey",
          "replayed"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted"
            ]
          },
          "groupId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "messageIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "replayed": {
            "type": "boolean"
          },
          "notifyUserId": {
            "type": "string",
            "nullable": true,
            "description": "Effective @recipient, or null for group text without @."
          }
        }
      }
    }
  }
}
